# ===================================
# AI News Digest - 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# ===================================

# ===================================
# AI / LLM 配置
# ===================================

# LiteLLM 统一模型配置
# LITELLM_MODEL=gemini/gemini-3-flash-preview
# LITELLM_FALLBACK_MODELS=openai/gpt-4o-mini

# LiteLLM 多通道/配置文件路径
# LITELLM_CONFIG=litellm_config.yaml
# LLM_CHANNELS=[{"name":"gemini","api_keys":["key1"],"models":["gemini-2.5-flash"]}]

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI 兼容 API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# AIHubMix (国内中转，自动配置 OpenAI base_url)
# AIHUBMIX_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# ===================================
# AI Daily Digest 配置
# ===================================

# 是否启用 AI Daily Digest（默认 true）
# AI_DAILY_DIGEST_ENABLED=true

# 文章抓取窗口（天）
# AI_DAILY_DIGEST_DAYS=2

# 精选文章数量
# AI_DAILY_DIGEST_TOP_N=15

# 输出语言：zh（中文）/ en（英文）
# AI_DAILY_DIGEST_LANGUAGE=zh

# 推送间隔（小时）：24=每天，48=每2天（默认），168=每周
DIGEST_INTERVAL_HOURS=48

# ===================================
# 定时任务配置
# ===================================

# 启用定时任务
# SCHEDULE_ENABLED=false

# 每日执行时间（仅定时模式下有效）
# SCHEDULE_TIME=18:00

# 启动时立即执行一次
# SCHEDULE_RUN_IMMEDIATELY=true

# ===================================
# 通知渠道（至少配置一个）
# ===================================

# 企业微信 Webhook
# WECHAT_WEBHOOK_URL=

# 飞书 Webhook
# FEISHU_WEBHOOK_URL=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=

# 邮件（SMTP 自动识别）
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=
# EMAIL_SENDER_NAME=AI News Digest

# Pushover（手机/桌面推送）
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=

# PushPlus（国内推送服务）
# PUSHPLUS_TOKEN=

# Server酱3
# SERVERCHAN3_SENDKEY=

# 自定义 Webhook（钉钉、Bark等）
# CUSTOM_WEBHOOK_URLS=
# CUSTOM_WEBHOOK_BEARER_TOKEN=

# Discord
# DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=

# Slack
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# AstrBot
# ASTRBOT_URL=
# ASTRBOT_TOKEN=

# Markdown 转图片（对不支持 Markdown 的渠道以图片发送）
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,wechat
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000

# ===================================
# 系统配置
# ===================================

# LOG_LEVEL=INFO
# LOG_DIR=./logs
# DEBUG=false

# HTTP 代理
# HTTP_PROXY=
# HTTPS_PROXY=
